<VirtualHost *:{{ site_listen_port }}>
    ServerName {{ site_domain }}
    DocumentRoot {{ site_root }}

    <Directory {{ site_root }}>
        AllowOverride All
        Require all granted
    </Directory>

    ErrorLog /var/log/httpd/{{ site_domain }}_error.log
    CustomLog /var/log/httpd/{{ site_domain }}_access.log combined

    <FilesMatch \.php$>
        SetHandler "proxy:unix:/run/php-fpm/www.sock|fcgi://localhost"
    </FilesMatch>
</VirtualHost>
